# Configuración Doxygen del firmware transmisor LoRa.
DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Transmisor LoRa ESP32"
PROJECT_BRIEF          = "Firmware ESP-IDF 6.1 con SX1278, MPU6050 y BME680"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
INPUT                  = main README.md
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
EXCLUDE                =
EXCLUDE_PATTERNS       = */build/* */managed_components/*
USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
QUIET                  = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = api
GENERATE_LATEX         = NO
GENERATE_XML           = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
HAVE_DOT               = NO
FULL_PATH_NAMES        = NO
TAB_SIZE               = 4
